#define VER_NUM 1,6,0,0
#define VER_STR "1.6.0.0"
1 ICON "1eye.ico"
1 24 "1eye.manifest"
1 VERSIONINFO
FILEVERSION VER_NUM
PRODUCTVERSION VER_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "1EYE"
      VALUE "FileDescription", "1EYE - Telepathic Data Transfer"
      VALUE "FileVersion", VER_STR
      VALUE "InternalName", "1EYE"
      VALUE "LegalCopyright", "Copyright (c) 2026 Balaj. MIT License."
      VALUE "OriginalFilename", "1EYE.exe"
      VALUE "ProductName", "1EYE"
      VALUE "ProductVersion", VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
